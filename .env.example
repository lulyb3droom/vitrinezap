# Neon PostgreSQL (use a connection string "pooled" do painel do Neon)
DATABASE_URL="postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Auth.js — gere com: npx auth secret   (ou openssl rand -base64 32)
AUTH_SECRET=""

# Vercel Blob (Storage > Blob no painel da Vercel) — upload de logos e fotos
BLOB_READ_WRITE_TOKEN=""

# URL pública (usada para exibir o link da loja)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
